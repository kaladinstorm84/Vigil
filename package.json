{
  "name": "vigilui",
  "version": "1.0.0",
  "description": "Zero-dependency declarative dashboard framework — turn any JSON API into a live dashboard with HTML attributes",
  "main": "vigil.js",
  "module": "dist/vigil.esm.js",
  "style": "vigil.css",
  "types": "vigil.d.ts",
  "files": [
    "vigil.js",
    "vigil.css",
    "vigil.d.ts",
    "dist/"
  ],
  "scripts": {
    "dev": "npx serve . -p 3000",
    "build": "node build.js",
    "test": "node tests/run.js",
    "lint:css": "npx stylelint vigil.css",
    "lint:js": "npx eslint vigil.js"
  },
  "keywords": [
    "dashboard",
    "monitoring",
    "live-polling",
    "data-binding",
    "websocket",
    "sparkline",
    "declarative",
    "real-time",
    "no-build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kaladinstorm84/Vigil.git"
  },
  "homepage": "https://github.com/kaladinstorm84/Vigil",
